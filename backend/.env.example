# Copiar a .env y completar. Todo tiene un valor por defecto salvo las claves.
# Guía completa: docs/setup.md (instalación) y docs/channels.md (WhatsApp, Messenger, Instagram).

# --- Generador: cualquier servidor compatible con la API de OpenAI -----------------------------------------
# Ollama Cloud (lo que usa la demo): la key se crea en https://ollama.com/settings/keys
LLM_BASE_URL=https://ollama.com/v1
LLM_MODEL=gemma4:31b
LLM_API_KEY=

# Local con Ollama (Gemma 4 E4B, ~7 GB de RAM o una GPU de 8 GB):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=gemma4:e4b
# LLM_API_KEY=ollama

# Local con llama.cpp (LFM3-1.7B; b11960 o más nuevo; GGUF en LiquidAI/LFM3-1.7B-GGUF):
#   llama-server -m LFM3-1.7B-Q4_K_M.gguf --host 127.0.0.1 --port 8081 -c 16384 --jinja --alias lfm3-1.7b
# LLM_BASE_URL=http://127.0.0.1:8081/v1
# LLM_MODEL=lfm3-1.7b
# LLM_RAZONAR=no

# vLLM en un servidor propio:
# LLM_BASE_URL=https://<tu-servidor>/v1
# LLM_MODEL=google/gemma-4-E4B-it
# LLM_API_KEY=...

# --- El medio ------------------------------------------------------------------------------------------------
# Valores iniciales: después se cambian desde la redacción (Ajustes), sin reiniciar.
NOMBRE_MEDIO=Factchequeado
RSS_URL=https://factchequeado.com/feed/

# --- Revisión de d1 (ver app/config.py) ----------------------------------------------------------------------
UMBRAL_RESPALDO=0.7
UMBRAL_CONTESTA=0.5
UMBRAL_HECHOS=0.5
# Para los temas que la redacción marque como «exigente»:
UMBRAL_RESPALDO_EXIGENTE=0.9
UMBRAL_CONTESTA_EXIGENTE=0.7

# --- Datos -----------------------------------------------------------------------------------------------------
# DB_PATH=data/escucha.db
VENCIMIENTO_HORAS=168     # una semana: las conversaciones se borran solas después de este tiempo sin mensajes
TRAZAS_DIAS=30            # las trazas de cada turno se guardan este tiempo

# --- Sesiones de la redacción -----------------------------------------------------------------------------------
SESION_DIAS=14
SESION_SEGURA=no          # "si" detrás de HTTPS: la cookie solo viaja cifrada

# --- Canales de Meta (docs/channels.md) ---------------------------------------------------------------------------
# Sin tokens, los mensajes de salida se escriben en el log (modo de prueba).
META_VERIFY_TOKEN=        # cualquier texto largo: se pega igual en la configuración del webhook en Meta
META_APP_SECRET=          # App settings > Basic > App secret: verifica la firma de cada webhook
META_GRAPH_VERSION=v24.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MESSENGER_PAGE_TOKEN=
INSTAGRAM_TOKEN=

# --- Avisos a la redacción (docs/notifications.md) ----------------------------------------------------------------
# Sin configurar, los avisos se escriben en el log. A quién y cuándo se avisa se decide en Ajustes.
SLACK_WEBHOOK_URL=        # Incoming Webhook de Slack: https://hooks.slack.com/services/...
SMTP_HOST=                # Google Workspace: smtp-relay.gmail.com (relay) o smtp.gmail.com (contraseña de aplicación)
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=
URL_PUBLICA=              # dirección pública del servidor, para el enlace a la bandeja en los avisos
